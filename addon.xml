<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.videoland.nl" name="Videoland" version="1.0.0" provider-name="Nigel1992">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="inputstream.adaptive" version="21.5.0" optional="true"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Unofficial Videoland client</summary>
    <summary lang="nl_NL">Onofficiële Videoland-client</summary>
    <description lang="en_GB">Browse and play movies, series, and programs using your own Videoland subscription.</description>
    <description lang="nl_NL">Blader en speel films, series en programma's met je eigen Videoland-abonnement.</description>
    <platform>all</platform>
    <license>CC-BY-NC-4.0</license>
    <assets>
      <icon>icon.png</icon>
      <fanart>resources/media/background.jpg</fanart>
    </assets>
  </extension>
</addon>
